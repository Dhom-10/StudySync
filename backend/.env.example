# Copy to backend/.env

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://studysync:studysync@localhost:5432/studysync?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="studysync_token"

# Used to encrypt each user's personal Anthropic API key at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET="change-me-64-hex-chars-generated-with-openssl-rand-hex-32"

# Fallback Anthropic API key used when a user has not saved their own key in Settings.
# Leave blank to require every user to bring their own key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
