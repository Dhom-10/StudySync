# Copy to backend/.env

PORT=4000

# The frontend origin allowed to call this API with credentials (cookies).
FRONTEND_URL=http://localhost:3000

# SQLite file (created on first run)
DB_PATH=./studysync.db

# whisper.cpp CLI (brew install whisper-cpp) and a ggml model file, e.g. ggml-tiny.en.bin
WHISPER_BIN=whisper-cli
WHISPER_MODEL_PATH=./models/ggml-tiny.en.bin
FFMPEG_BIN=ffmpeg

# Ollama (ollama pull llama3.2:3b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
