# Used by docker-compose.yml for the Postgres container.
# Copy to `.env` in this same directory (docker-compose reads .env automatically).

POSTGRES_USER=studysync
POSTGRES_PASSWORD=studysync
POSTGRES_DB=studysync
POSTGRES_PORT=5432

# Optional pgAdmin (run with: docker compose --profile tools up)
PGADMIN_EMAIL=admin@studysync.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
